# Copy to .env for local use; on Vercel set these in Project Settings > Environment Variables.
# Leave the Turso values empty locally to use a file-based SQLite db (local.db).
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASS=gmail-app-password
BASE_URL=https://your-app.vercel.app
