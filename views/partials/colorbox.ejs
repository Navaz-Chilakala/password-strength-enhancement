<div class="colorbox">
    <div class="colorbox-title">
        <span>Colour your characters</span>
        <button type="button" class="link-btn" data-clear>Reset colours</button>
    </div>
    <div class="chips" data-chips aria-live="polite"></div>
    <div class="palette" role="group" aria-label="Colour palette">
        <button type="button" class="swatch" data-color="red"    style="background:#ef4444" aria-label="Red"></button>
        <button type="button" class="swatch" data-color="orange" style="background:#f59e0b" aria-label="Orange"></button>
        <button type="button" class="swatch" data-color="yellow" style="background:#facc15" aria-label="Yellow"></button>
        <button type="button" class="swatch" data-color="green"  style="background:#22c55e" aria-label="Green"></button>
        <button type="button" class="swatch" data-color="cyan"   style="background:#22d3ee" aria-label="Cyan"></button>
        <button type="button" class="swatch" data-color="blue"   style="background:#3b82f6" aria-label="Blue"></button>
        <button type="button" class="swatch" data-color="purple" style="background:#a855f7" aria-label="Purple"></button>
        <button type="button" class="swatch" data-color="pink"   style="background:#ec4899" aria-label="Pink"></button>
        <button type="button" class="swatch" data-color="brown"  style="background:#a16207" aria-label="Brown"></button>
        <button type="button" class="swatch clear" data-color="" aria-label="No colour for selected characters" title="Remove colour">&times;</button>
    </div>
    <p class="palette-note" data-note>Tap characters above (or select text in the box), then pick a colour.</p>
</div>
